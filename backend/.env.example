# Copy this file to .env for local development. Never commit the real .env file.

FLASK_ENV=development

# Flask's own secret (sessions, CSRF, etc.) - must be different from JWT_SECRET_KEY
SECRET_KEY=replace-with-output-of-secrets-token-hex-32

# JWT signing secret - must be different from SECRET_KEY above
JWT_SECRET_KEY=replace-with-a-different-output-of-secrets-token-hex-32

# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Mqulwa@05
MYSQL_DATABASE=CampusQueue_System

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5500,https://your-site.netlify.app

# Domain used to build student emails: studentnumber@<this domain>
STUDENT_EMAIL_DOMAIN=mywsu.ac.za